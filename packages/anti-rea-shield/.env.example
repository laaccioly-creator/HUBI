# Configuração da Suíte Anti-REA-Shield (HUBI / Open Source)

# Modo de operação: 'development' | 'simulation' | 'production'
# - development: Monitoramento passivo, DevTools livre, localhost permitido.
# - simulation: (Padrão) Registra eventos de risco no console sem degradar ou bloquear a UI.
# - production: Ativa Domain Lock estrito, Degradação Silenciosa estocástica e Ofuscação Polimórfica.
VITE_SHIELD_MODE=simulation

# Semente criptográfica para derivação polimórfica de identificadores, classes CSS e marcas d'água
VITE_SHIELD_SECRET_SEED=hubi-default-polymorphic-seed-2026

# Lista de domínios oficiais autorizados (separados por vírgula)
VITE_SHIELD_ALLOWED_DOMAINS=localhost,127.0.0.1,hubi-studio.ai.studio
